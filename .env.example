# Local development uses SQLite automatically.
# To use PostgreSQL, uncomment and update:
# DATABASE_URL=postgresql://user:password@localhost:5432/bullfrog_projects

# Preferred: the complete "Basic ..." Authorization value from Rev.io Billing.
REVIO_BILLING_AUTHORIZATION=

# Optional fallback: separate Basic authentication components.
REVIO_BILLING_USERNAME=
REVIO_BILLING_CLIENT_CODE=
REVIO_BILLING_PASSWORD=
REVIO_BILLING_BASE_URL=https://restapi.rev.io

# Quote Signed hardware-order automation.
HARDWARE_ORDER_EMAIL=sales@bullfrog.net
HARDWARE_ORDER_CHECK_SECONDS=3600
