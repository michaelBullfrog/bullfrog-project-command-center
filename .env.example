# Local development uses SQLite automatically.
# To use PostgreSQL, uncomment and update:
# DATABASE_URL=postgresql://user:password@localhost:5432/bullfrog_projects

# Preferred: the complete "Basic ..." Authorization value from Rev.io Billing.
REVIO_BILLING_AUTHORIZATION=

# Optional fallback: separate Basic authentication components.
REVIO_BILLING_USERNAME=
REVIO_BILLING_CLIENT_CODE=
REVIO_BILLING_PASSWORD=
REVIO_BILLING_BASE_URL=https://restapi.rev.io

# Quote Signed hardware-order automation.
HARDWARE_ORDER_EMAIL=sales@bullfrog.net
HARDWARE_ORDER_CHECK_SECONDS=3600

# Project milestone notifications.
# The web service runs this review daily at 7:00 AM America/New_York.
PSA_NOTIFICATION_SENDER=michael@bullfrog.net
GO_LIVE_NOTIFICATION_EMAIL=carrie@bullfrog.net
PSA_MILESTONE_NOTIFICATION_EMAIL=psanotification@bullfrog.net
PROJECT_NOTIFICATION_TIMEZONE=America/New_York
PROJECT_NOTIFICATION_HOUR=7
FOC_APPROACHING_DAYS=7


# Rev PSA milestone ticket automation.
# Disabled by default; Hardware Paid billing/email automation remains active.
REVIO_PSA_TICKET_AUTOMATION_ENABLED=false
# Defaults match the Bullfrog PSA configuration supplied for this app.
REVIO_PSA_TICKET_CREATE_PATH=/psac/api/v1/ticket
REVIO_PSA_TICKET_UPDATE_PATH=/psac/api/v1/ticket/{ticket_id}
REVIO_PSA_TICKET_DETAIL_PATH=/psac/api/v1/ticket/{ticket_id}
REVIO_PSA_TICKET_TYPE_ID=3
REVIO_PSA_NEW_STATUS_ID=1
REVIO_PSA_COMPLETE_STATUS_ID=4
REVIO_PSA_PRIORITY_ID=2
# Rev PSA board for project-generated tickets. The app resolves the name to its numeric ID.
REVIO_PSA_PROJECT_TICKET_BOARD=Onboarding
REVIO_PSA_PROJECT_TICKET_BOARD_ID=
REVIO_PSA_TICKET_BOARDS_PATH=/psac/api/v1/boards
REVIO_PSA_TICKET_BULK_BOARD_PATH=/psac/api/v1/tickets/bulk/board
REVIO_PSA_TICKET_BULK_TECH_PATH=/psac/api/v1/tickets/bulk/technician
REVIO_PSA_TICKET_CHECK_SECONDS=3600

# Rev PSA customer lookup and project-management APIs.
REVIO_API_KEY=
REVIO_BASE_URL=https://api.psarev.io
REVIO_PROJECT_BASE_URL=https://apim.psarev.io
REVIO_HOST=bullfrog.psarev.io
REVIO_TOKEN_EXCHANGE_PATH=/api/v1/auth/api-key/exchange
REVIO_CUSTOMER_PATH=/billing/api/v1/customers/{customer_id}

# Rev PSA phase statuses. The first project phase starts Active; later phases start Planned.
REVIO_PSA_PHASE_ACTIVE_STATUS_ID=2
REVIO_PSA_PHASE_PLANNED_STATUS_ID=1
